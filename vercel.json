    { "src": "/db-connect", "dest": "/api/db_connect.php" },
    { "src": "/export-all-infra-excel", "dest": "/api/export_all_infra_excel.php" },
    { "src": "/export-excel", "dest": "/api/export_excel.php" },
    { "src": "/export-pending-excel", "dest": "/api/export_pending_excel.php" },
    { "src": "/export-student-excel", "dest": "/api/export_student_excel.php" },
    { "src": "/export-student-pending-excel", "dest": "/api/export_student_pending_excel.php" },
