    { "src": "/rice-report-panel", "dest": "/api/rice_report_panel.php" },
    { "src": "/rice-report-view", "dest": "/api/rice_report_view.php" },
    { "src": "/ricerequirement", "dest": "/api/ricerequirement.php" },
    { "src": "/save-data", "dest": "/api/save_data.php" },
