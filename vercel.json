{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/admin-dashboard", "dest": "/api/admin_dashboard.php" },
    { "src": "/admin-login", "dest": "/api/admin_login.php" },
    { "src": "/admin-rice-view", "dest": "/api/admin_rice_view.php" },
